<?xml version="1.0" encoding="utf-8"?>
<!-- IBus component registration. Must be installed into the one
     directory ibus-daemon scans: <ibus pkgdatadir>/component (usually
     /usr/share/ibus/component — NOT relative to our install prefix);
     ibus-daemon spawns <exec> on demand. Paths are filled in by CMake
     at configure time. -->
<component>
  <name>com.paiza.inputmethod.mongolian</name>
  <description>Paiza Mongolian IME</description>
  <exec>@PAIZA_INSTALL_BIN_DIR@/ibus-engine-paiza --ibus</exec>
  <version>@PROJECT_VERSION@</version>
  <author>Paiza</author>
  <license>AGPL-3.0</license>
  <homepage>https://github.com/hugohu789-droid/paiza</homepage>
  <textdomain>ibus-paiza</textdomain>
  <engines>
    <engine>
      <name>paiza-mongolian</name>
      <longname>Paiza Mongolian</longname>
      <description>Traditional Mongolian (vertical script) input</description>
      <language>mn</language>
      <license>AGPL-3.0</license>
      <author>Paiza</author>
      <icon>@PAIZA_INSTALL_DATA_DIR@/paiza-mn.png</icon>
      <layout>us</layout>
      <rank>50</rank>
      <setup>@PAIZA_INSTALL_BIN_DIR@/paiza-ime-settings</setup>
    </engine>
  </engines>
</component>
